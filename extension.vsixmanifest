<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="clean-python-code" Version="0.3.10" Publisher="cleanpythoncode" />
    <DisplayName>Clean Python Code</DisplayName>
    <Description xml:space="preserve">Personalized Python and PySpark formatting with hierarchical indentation, vertical chains, and aligned nested expressions.</Description>
    <Tags>python,pyspark,formatter,code formatting,indentation,jupyter,notebook,data analytics,data engineering</Tags>
    <Categories>Formatters, Programming Languages, Data Science, Notebooks</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Code.Engine" Value=">=1.90.0" />
      <Property Id="Microsoft.VisualStudio.Services.Content.Types" Value="Microsoft.VisualStudio.Code" />
      <Property Id="Microsoft.VisualStudio.Services.Content.Pricing" Value="Free" />
    </Properties>
    <Icon>extension/icon.png</Icon>
    <License>extension/LICENSE.txt</License>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Code" />
  </Installation>
  <Dependencies />
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/README.md" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Changelog" Path="extension/CHANGELOG.md" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" Path="extension/LICENSE.txt" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="extension/icon.png" Addressable="true" />
  </Assets>
</PackageManifest>
